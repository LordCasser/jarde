.DS_Store
# Fuzz workspace build output and crash artifacts. The committed seeds under
# `fuzz/corpus/` are the only corpus inputs that are tracked; a smoke run is
# started against a scratch copy so new inputs never land in the repository.
/fuzz/target/
/fuzz/artifacts/
/fuzz/coverage/
# OpenSpec run evidence stays local: raw logs, captures, binaries, and generated
# receipts are not repository content. Human-written Markdown summaries remain tracked.
/openspec/**/results/**
!/openspec/**/results/**/
!/openspec/**/results/**/*.md
/openspec/**/evidence/**
!/openspec/**/evidence/**/
!/openspec/**/evidence/**/*.md
