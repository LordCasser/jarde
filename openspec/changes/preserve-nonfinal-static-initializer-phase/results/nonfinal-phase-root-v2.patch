+#[test]
+fn nonfinal_runtime_constant_keeps_its_phase_in_an_ordered_static_group() {
+    let dir = std::env::temp_dir().join(format!("jarde-em06-nonfinal-{}", std::process::id()));
+    fs::create_dir_all(&dir).expect("scratch directory");
+    compile(&dir, "NonfinalRuntime.java", NONFINAL_RUNTIME);
+    let bytes = fs::read(dir.join("NonfinalRuntime.class")).expect("compiled class");
+    let report = report(&bytes, "NonfinalRuntime");
+    let ClassSourceInitializerProof::Proved { fields } = &report.initializer_proof else {
+        panic!("nonfinal runtime initializer group refused: {:?}", report.initializer_proof)
+    };
+    assert_eq!(fields.len(), 2);
+    assert_eq!(
+        fields.iter().map(|field| field.write_order).collect::<Vec<_>>(),
+        [0, 1]
+    );
+
+    let trace = report.fields.iter().find(|field| field.item.name.raw().0 == b"trace").unwrap();
+    let marks = report.fields.iter().find(|field| field.item.name.raw().0 == b"marks").unwrap();
+    assert_eq!(
+        fields.iter().map(|proof| proof.field_index).collect::<Vec<_>>(),
+        vec![trace.item.index, marks.item.index]
+    );
+    assert_eq!(trace.item.access_flags & 0x0010, 0, "trace stays nonfinal");
+    assert!(trace.declaration.as_deref().unwrap().contains("trace = 0"));
+    assert!(marks.declaration.as_deref().unwrap().contains("byte[] marks ="));
+    assert!(marks.declaration.as_deref().unwrap().contains("mark()"));
+    assert_eq!(report.text.matches("trace = 0").count(), 1);
+    assert_eq!(report.text.matches("marks = ").count(), 1);
+    assert!(!report.text.contains("static {"), "{}", report.text);
+
+    let clinit = report
+        .methods
+        .iter()
+        .find(|method| method.item.identity.name.0 == b"<clinit>")
+        .expect("physical <clinit> remains in the class report");
+    let ClassSourceOutcome::Recovered { report: body, .. } = &clinit.outcome else {
+        panic!("the physical initializer remains recovered")
+    };
+    assert_eq!(clinit.text.matches("static {").count(), 1);
+    for proof in fields {
+        assert!(
+            !body.source_map.of_bci(proof.write_bci).is_empty(),
+            "physical write BCI {} remains anchored",
+            proof.write_bci
+        );
+    }
+    assert!(report.methods.iter().any(|method| method.item.identity.name.0 == b"mark"));
+    fs::remove_dir_all(dir).expect("remove scratch directory");
+}
