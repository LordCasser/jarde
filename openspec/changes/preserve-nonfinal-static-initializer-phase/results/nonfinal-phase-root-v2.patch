+#[test]
+fn final_runtime_constant_without_constant_value_still_refuses_phase_change() {
+    let dir = std::env::temp_dir().join(format!("jarde-em06-final-phase-{}", std::process::id()));
+    fs::create_dir_all(&dir).expect("scratch directory");
+    compile(&dir, "FinalRuntime.java", FINAL_RUNTIME);
+    let bytes = fs::read(dir.join("FinalRuntime.class")).expect("compiled class");
+    let report = report(&bytes, "FinalRuntime");
+    let ClassSourceInitializerProof::Refused { reason } = &report.initializer_proof else {
+        panic!(
+            "blank-final runtime constant must remain in <clinit>: {:?}",
+            report.initializer_proof
+        )
+    };
+    assert!(
+        reason.contains("constant expression") && reason.contains("initialization phase"),
+        "{reason}"
+    );
+    let value = report.fields.iter().find(|field| field.item.name.raw().0 == b"value").unwrap();
+    assert_ne!(value.item.access_flags & 0x0010, 0, "value remains final");
+    assert!(value.declaration.as_deref().is_some_and(|text| !text.contains(" = ")));
+    assert!(report.text.contains("final int value;"));
+    assert!(report.text.contains("static {"));
+    assert!(report.text.contains("value = 7"), "{}", report.text);
+
+    let clinit = report
+        .methods
+        .iter()
+        .find(|method| method.item.identity.name.0 == b"<clinit>")
+        .expect("physical <clinit> is retained");
+    let ClassSourceOutcome::Recovered { report: body, .. } = &clinit.outcome else {
+        panic!("physical <clinit> remains recoverable")
+    };
+    assert!(clinit.text.contains("static {"));
+    assert!(clinit.text.contains("value = 7"));
+    assert!(
+        !body.source_map.segments.is_empty(),
+        "physical initializer keeps source origins"
+    );
+    fs::remove_dir_all(dir).expect("remove scratch directory");
+}
