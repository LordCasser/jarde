+    #[test]
+    fn refused_root_without_child_keeps_same_class_integer_constant_names() {
+        let report = source(
+            REFUSED_ROOT,
+            "jadx/tests/integration/switches/TestSwitchLabels$TestCls",
+            &mut task_budget(&[]).unwrap(),
+        );
+
+        assert!(matches!(
+            report.execution,
+            ExecutionReport::Complete { .. }
+        ));
+        assert!(matches!(
+            &report.member_family,
+            class_source::ClassSourceMemberFamily::Refused { child: None, .. }
+        ));
+        let mut nesting_budget = task_budget(&[]).unwrap();
+        let selected = jarde_reader::classfile::class_facts(REFUSED_ROOT, &mut nesting_budget)
+            .expect("the frozen root's class facts remain readable");
+        let shells: Vec<_> = selected
+            .attributes
+            .iter()
+            .filter(|attribute| {
+                matches!(
+                    attribute.name.raw().0.as_slice(),
+                    b"InnerClasses" | b"EnclosingMethod"
+                )
+            })
+            .cloned()
+            .collect();
+        let assembly = class_source::read_class_source_assembly_context(
+            REFUSED_ROOT,
+            &shells,
+            &selected.constant_pool,
+            &mut nesting_budget,
+        )
+        .expect("the selected root's nesting attributes decode into typed facts");
+        assert!(assembly.resolved_inner_classes.iter().any(|row| {
+            row.class.as_slice() == b"jadx/tests/integration/switches/TestSwitchLabels$TestCls"
+                && row.outer_class.as_deref()
+                    == Some(&b"jadx/tests/integration/switches/TestSwitchLabels"[..])
+                && row.inner_name.as_ref().map(|name| name.0.as_slice())
+                    == Some(&b"TestCls"[..])
+        }), "the reader-resolved self row states TestSwitchLabels$TestCls -> TestSwitchLabels");
+        assert!(assembly.resolved_inner_classes.iter().any(|row| {
+            row.class.as_slice()
+                == b"jadx/tests/integration/switches/TestSwitchLabels$TestCls$Inner"
+                && row.outer_class.as_deref()
+                    == Some(&b"jadx/tests/integration/switches/TestSwitchLabels$TestCls"[..])
+                && row.inner_name.as_ref().map(|name| name.0.as_slice()) == Some(&b"Inner"[..])
+        }), "the reader-resolved child row states TestSwitchLabels$TestCls$Inner -> TestSwitchLabels$TestCls");
+        assert!(matches!(
+            report.nested_enum_family,
+            class_source::ClassSourceNestedEnumFamily::Absent
+        ));
+        assert!(matches!(
+            report.nested_annotation_family,
+            class_source::ClassSourceNestedAnnotationFamily::Absent
+        ));
+        assert!(matches!(
+            report.anonymous_interface_projection,
+            class_source::ClassSourceAnonymousInterfaceProjection::Absent
+        ));
+
+        assert!(report.text.contains("case CONST_ABC:"));
+        assert!(report.text.contains("return CONST_CDE;"));
+        assert!(!report.text.contains("class Inner"));
+
+        let method = report
+            .methods
+            .iter()
+            .find(|method| {
+                method.item.name.raw().0 == b"f1"
+                    && method.item.descriptor.raw().0 == b"(I)I"
+            })
+            .expect("the frozen root declares physical f1(I)I");
+        let class_source::ClassSourceOutcome::Recovered {
+            report: physical, ..
+        } = &method.outcome
+        else {
+            panic!("f1(I)I must retain its physical recovery report");
+        };
+        assert!(physical.text.contains("case 2748:"));
+        assert!(physical.text.contains("return 3294;"));
+
+        let abc = report
+            .integer_constant_candidates
+            .iter()
+            .find(|candidate| candidate.name == "CONST_ABC")
+            .expect("the root field table proves CONST_ABC");
+        let cde = report
+            .integer_constant_candidates
+            .iter()
+            .find(|candidate| candidate.name == "CONST_CDE")
+            .expect("the root field table proves CONST_CDE");
+        assert_eq!(abc.value, 2748);
+        assert_eq!(cde.value, 3294);
+        let abc_field = report
+            .fields
+            .iter()
+            .find(|field| field.item.name.raw().0 == b"CONST_ABC")
+            .expect("the candidate is a real root field");
+        let cde_field = report
+            .fields
+            .iter()
+            .find(|field| field.item.name.raw().0 == b"CONST_CDE")
+            .expect("the candidate is a real root field");
+        assert_eq!(abc_field.item.index, abc.field.index);
+        assert_eq!(abc_field.item.identity, abc.field.identity);
+        assert_eq!(abc_field.declaration.as_deref(), Some("public static final int CONST_ABC = 2748"));
+        assert_eq!(cde_field.item.index, cde.field.index);
+        assert_eq!(cde_field.item.identity, cde.field.identity);
+        assert_eq!(cde_field.declaration.as_deref(), Some("public static final int CONST_CDE = 3294"));
+
+        let mut method_projections = report
+            .integer_constant_projections
+            .iter()
+            .filter(|projection| {
+                projection.anchors.iter().any(|anchor| matches!(
+                    anchor,
+                    class_source::MemberFamilyPhysicalAnchor::MethodPoint { method: owner, .. }
+                        if owner == &method.item.identity
+                ))
+            })
+            .collect::<Vec<_>>();
+        assert_eq!(method_projections.len(), 2);
+        method_projections.sort_by_key(|projection| {
+            projection
+                .anchors
+                .iter()
+                .find_map(|anchor| match anchor {
+                    class_source::MemberFamilyPhysicalAnchor::MethodPoint { method: owner, bci }
+                        if owner == &method.item.identity => Some(*bci),
+                    _ => None,
+                })
+                .expect("each projection has its f1(I)I anchor")
+        });
+        for (projection, name, field, bci) in [
+            (&method_projections[0], "CONST_ABC", abc_field, 1),
+            (&method_projections[1], "CONST_CDE", cde_field, 20),
+        ] {
+            assert_eq!(
+                projection.kind,
+                class_source::MemberFamilyDerivedKind::IntegerConstantName
+            );
+            assert_eq!(report.text.get(projection.start..projection.end), Some(name));
+            assert_eq!(
