+        assert!(matches!(child.execution, ExecutionReport::Complete { .. }));
+        assert!(matches!(
+            &child.member_family,
+            class_source::ClassSourceMemberFamily::Refused { child: None, .. }
+        ));
+        assert!(matches!(
+            child.nested_enum_family,
+            class_source::ClassSourceNestedEnumFamily::Absent
+        ));
+        assert!(matches!(
+            child.nested_annotation_family,
+            class_source::ClassSourceNestedAnnotationFamily::Absent
+        ));
+        assert!(matches!(
+            child.anonymous_interface_projection,
+            class_source::ClassSourceAnonymousInterfaceProjection::Absent
+        ));
+        assert!(child.text.contains("case CONST_CDE_PRIVATE:"));
+        assert!(child.text.contains("return 2748;"));
+        assert!(!child.text.contains("CONST_ABC"));
+        assert!(child
+            .integer_constant_candidates
+            .iter()
+            .all(|candidate| candidate.name != "CONST_ABC"));
+
+        let child_method = child
+            .methods
+            .iter()
+            .find(|method| {
+                method.item.name.raw().0 == b"f1"
+                    && method.item.descriptor.raw().0 == b"(I)I"
+            })
+            .expect("the frozen child declares physical f1(I)I");
+        let class_source::ClassSourceOutcome::Recovered {
+            report: child_physical, ..
+        } = &child_method.outcome
+        else {
+            panic!("child f1(I)I must retain its physical recovery report");
+        };
+        assert!(child_physical.text.contains("case 3294:"));
+        assert!(child_physical.text.contains("return 2748;"));
+
+        let mut child_candidates = child
+            .integer_constant_candidates
+            .iter()
+            .filter(|candidate| candidate.name == "CONST_CDE_PRIVATE");
+        let child_candidate = child_candidates
+            .next()
+            .expect("the child field table proves CONST_CDE_PRIVATE");
+        assert!(child_candidates.next().is_none());
+        assert_eq!(child_candidate.value, 3294);
+        let child_field = child
+            .fields
+            .iter()
+            .find(|field| field.item.name.raw().0 == b"CONST_CDE_PRIVATE")
+            .expect("the candidate is a real child field");
+        assert_eq!(child_field.item.index, child_candidate.field.index);
+        assert_eq!(child_field.item.identity, child_candidate.field.identity);
+        assert_eq!(
+            child_field.declaration.as_deref(),
+            Some("private static final int CONST_CDE_PRIVATE = 3294")
+        );
+
+        let child_projections: Vec<_> = child
+            .integer_constant_projections
+            .iter()
+            .filter(|projection| {
+                projection.anchors.iter().any(|anchor| matches!(
+                    anchor,
+                    class_source::MemberFamilyPhysicalAnchor::MethodPoint { method: owner, .. }
+                        if owner == &child_method.item.identity
+                ))
+            })
+            .collect();
+        let [child_projection] = child_projections.as_slice() else {
+            panic!("the child f1(I)I has one derived case-name projection");
+        };
+        assert_eq!(
+            child_projection.kind,
+            class_source::MemberFamilyDerivedKind::IntegerConstantName
+        );
+        assert_eq!(
+            child.text.get(child_projection.start..child_projection.end),
+            Some("CONST_CDE_PRIVATE")
+        );
+        assert_eq!(
+            child_projection.anchors,
+            vec![
+                class_source::MemberFamilyPhysicalAnchor::Field {
+                    field: child_field.item.identity.clone(),
+                    index: child_field.item.index,
+                },
+                class_source::MemberFamilyPhysicalAnchor::MethodPoint {
+                    method: child_method.item.identity.clone(),
+                    bci: 1,
+                },
+            ]
+        );
+    }
