+def javap_exception_table(raw,name,desc,constructor_name):
+    """Read the exact Code exception table from this switch-free fixture's Javap method block."""
+    lines=raw.decode('utf-8').splitlines(); target=None
+    for i,line in enumerate(lines):
+        if line.strip()==f'descriptor: {desc}':
+            prior=next((lines[j].strip() for j in range(i-1,max(-1,i-5),-1) if '(' in lines[j] and ')' in lines[j]),'')
+            head=prior.split('(',1)[0].split()[-1].rsplit('.',1)[-1] if prior else ''
+            if (name=='<init>' and head==constructor_name) or head==name:
+                target=i; break
+    need(target is not None,f'javap method declaration missing {name}{desc}')
+    end=next((j for j in range(target+1,len(lines)) if lines[j].strip().startswith('descriptor: ')),len(lines))
+    block=lines[target:end]; starts=[i for i,line in enumerate(block) if line.strip()=='Exception table:']
+    need(len(starts)<=1,f'duplicate Javap exception table {name}{desc}')
+    if not starts: return []
+    i=starts[0]+1
+    need(i<len(block) and re.fullmatch(r'\s*from\s+to\s+target\s+type\s*',block[i]) is not None,
+         f'Javap exception table header missing {name}{desc}')
+    rows=[]; i+=1
+    while i<len(block) and block[i].strip():
+        m=re.fullmatch(r'\s*(\d+)\s+(\d+)\s+(\d+)\s+(any|Class\s+([^\s]+))\s*',block[i])
+        if m is None:
+            need(re.match(r'\s*\d+\s',block[i]) is None,
+                 f'malformed Javap exception row for {name}{desc}: {block[i]!r}')
+            break
+        start_pc,end_pc,handler_pc=map(int,m.group(1,2,3)); catch_type=None if m.group(4)=='any' else m.group(5)
+        rows.append({'start_pc':start_pc,'end_pc':end_pc,'handler_pc':handler_pc,'catch_type':catch_type}); i+=1
+    return rows
