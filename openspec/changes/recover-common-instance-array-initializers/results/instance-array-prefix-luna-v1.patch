+/// Extracts only a top-level, immediately post-`super` sequence of claimed primitive-array
+/// field writes. The caller still proves class-wide completeness, field declarations, and static
+/// call targets before committing any source edit.
+#[doc(hidden)]
+pub fn class_source_instance_array_constructor_projection(
+    ast: &ClassSourceMethodAst,
+    budget: &mut Budget,
+) -> Result<Option<ClassSourceInstanceArrayConstructorProjection>, crate::stop::StopReason> {
+    let source = &ast.projection;
+    let Some(init) = source.generic_call_init.as_ref() else {
+        return Ok(None);
+    };
+    if !source.complete_code
+        || source.has_exception_handlers
+        || !init.presented
+        || init.target != Some(crate::ast::ConstructorTarget::Super)
+    {
+        return Ok(None);
+    }
+    let Some(crate::ast::Stmt {
+        kind: StmtKind::ConstructorCall {
+            target: ConstructorTarget::Super,
+            ..
+        },
+        origin,
+    }) = source.program.stmts.first()
+    else {
+        return Ok(None);
+    };
+    if Some(origin.primary().bci()) != init.bci {
+        return Ok(None);
+    }
+
+    let mut writes = Vec::new();
+    let mut prefix_bcis = std::collections::BTreeSet::new();
+    let mut cursor = 1usize;
+    for statement in source.program.stmts.iter().skip(1) {
+        let StmtKind::FieldAssign {
+            receiver: Some(receiver),
+            name,
+            op: AssignOp::Assign,
+            value,
+        } = &statement.kind
+        else {
+            break;
+        };
+        if !matches!(&receiver.kind, ExprKind::Local(name) if name == "this") {
+            break;
+        }
+        let bci = statement.origin.primary().bci();
+        let Some(evidence) = source
+            .instance_field_write_evidence
+            .iter()
+            .find(|evidence| evidence.bci == bci)
+        else {
+            break;
+        };
+        if evidence.is_static || evidence.name != *name || !prefix_bcis.insert(bci) {
+            break;
+        }
+        let ExprKind::NewArray {
+            element,
+            lengths,
+            initializers: Some(initializers),
+            total_dimensions: 1,
+        } = &value.kind
+        else {
+            break;
+        };
+        if !matches!(
+            element,
+            Type::Boolean | Type::Byte | Type::Char | Type::Short | Type::Int | Type::Long | Type::Float | Type::Double
+        ) || !lengths.is_empty()
+            || !matches!(
+                value.presented,
+                Some(Type::Reference(ref presented))
+                    if presented == &format!("{}[]", element.spell())
+            )
+        {
+            break;
+        }
+        let mut calls = Vec::new();
+        if !initializers.iter().all(|expression| {
+            instance_array_value_supported(expression, source, &mut calls)
+        }) {
+            break;
+        }
+        let Some((_, _, field)) = source
+            .instance_field_write_evidence
+            .iter()
+            .find(|field| field.bci == bci)
+            .map(|field| (field.bci, field.is_static, field))
+        else {
+            break;
+        };
+        let rendered = crate::emit::emit_class_initializer_value(
+            value,
+            &source.member,
+            source.current_class.as_deref(),
+            &source.nested_class_members,
+            budget,
+        )?;
+        writes.push(ClassSourceInstanceArrayFieldWrite {
+            bci,
+            owner: field.owner.clone(),
+            name: field.name.clone(),
+            descriptor: field.descriptor.clone(),
+            value: rendered,
+            calls,
+        });
+        cursor += 1;
+    }
+    if writes.is_empty() {
+        return Ok(None);
+    }
+    for write in &writes {
+        let all_writes: Vec<_> = source
+            .instance_field_write_evidence
+            .iter()
+            .filter(|evidence| {
+                evidence.owner == write.owner
+                    && evidence.name == write.name
+                    && evidence.descriptor == write.descriptor
+            })
+            .collect();
+        if all_writes.len() != 1 || all_writes[0].bci != write.bci {
+            return Ok(None);
+        }
+    }
+    let remaining_body = crate::emit::emit_class_source_statements(
+        &source.program.stmts[cursor..],
+        &source.member,
+        source.current_class.as_deref(),
+        &source.nested_class_members,
+        4,
+        budget,
+    )?;
+    Ok(Some(ClassSourceInstanceArrayConstructorProjection {
+        member: source.member.clone(),
+        init: init.clone(),
+        writes,
+        remaining_body,
+    }))
+}
+
+fn instance_array_value_supported(
+    expression: &Expr,
+    source: &ClassSourceMethodAstSource,
+    calls: &mut Vec<crate::facts::CallTarget>,
+) -> bool {
+    match &expression.kind {
+        ExprKind::Integer(_) | ExprKind::Boolean(_) | ExprKind::Long(_) | ExprKind::Float(_) | ExprKind::Double(_) => true,
+        ExprKind::Cast { ty, value } => {
+            matches!(
+                ty,
+                Type::Boolean | Type::Byte | Type::Char | Type::Short | Type::Int | Type::Long | Type::Float | Type::Double
+            ) && matches!(
+                value.kind,
+                ExprKind::Integer(_) | ExprKind::Boolean(_) | ExprKind::Long(_) | ExprKind::Float(_) | ExprKind::Double(_)
+            )
+        }
+        ExprKind::Call {
+            receiver: None,
+            args,
+            ..
+        } if args.iter().all(|argument| match &argument.kind {
+            ExprKind::Integer(_) | ExprKind::Boolean(_) | ExprKind::Long(_) | ExprKind::Float(_) | ExprKind::Double(_) => true,
+            ExprKind::Cast { ty, value } => {
+                matches!(
+                    ty,
+                    Type::Boolean | Type::Byte | Type::Char | Type::Short | Type::Int | Type::Long | Type::Float | Type::Double
+                ) && matches!(
+                    value.kind,
+                    ExprKind::Integer(_) | ExprKind::Boolean(_) | ExprKind::Long(_) | ExprKind::Float(_) | ExprKind::Double(_)
+                )
+            }
+            _ => false,
+        }) => {
+            let bci = expression.origin.primary().bci();
+            let targets: Vec<_> = source
+                .call_targets
+                .iter()
+                .filter(|(target_bci, opcode, _)| *target_bci == bci && *opcode == 0xb8)
+                .collect();
+            let [( _, _, target)] = targets.as_slice() else {
+                return false;
+            };
+            calls.push((*target).clone());
+            true
+        }
+        _ => false,
+    }
 }
 
