+#[doc(hidden)]
+pub fn emit_class_source_instance_array_constructor_body(ast:&ClassSourceMethodAst,removed_bcis:&[u32],budget:&mut Budget)->Result<String,crate::stop::StopReason>{
+    let first_bci=ast.projection.instruction_bcis.first().copied();
