+    crate::stop::charge(budget,jarde_reader::budget::CountedBudgetDimension::IrItems,u64::try_from(removed_bcis.len()).unwrap_or(u64::MAX),first_bci)?;
+    let mut removed=std::collections::BTreeSet::new();for bci in removed_bcis{crate::stop::poll(budget,Some(*bci))?;crate::stop::charge(budget,jarde_reader::budget::CountedBudgetDimension::AnalysisSteps,1,Some(*bci))?;removed.insert(*bci)}
+    let mut stmts=Vec::new();for stmt in &ast.projection.program.stmts{let bci=stmt.origin.primary().bci();crate::stop::poll(budget,Some(bci))?;crate::stop::charge(budget,jarde_reader::budget::CountedBudgetDimension::AnalysisSteps,1,Some(bci))?;if !removed.contains(&bci){stmts.push(stmt.clone())}}
+    crate::emit::emit_class_source_statements(&stmts,&ast.projection.member,ast.projection.current_class.as_deref(),&ast.projection.nested_class_members,4,budget)
