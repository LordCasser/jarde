+fn primitive_array_initializer(expr:&Expr,budget:&mut Budget)->Result<bool,crate::stop::StopReason>{
+    crate::stop::poll(budget,Some(expr.origin.primary().bci()))?;
+    crate::stop::charge(budget,jarde_reader::budget::CountedBudgetDimension::AnalysisSteps,1,Some(expr.origin.primary().bci()))?;
+    let ExprKind::NewArray{element,lengths,initializers:Some(values),total_dimensions:1}=&expr.kind else{return Ok(false)};
+    if !lengths.is_empty()||!matches!(element,Type::Boolean|Type::Byte|Type::Char|Type::Short|Type::Int|Type::Long|Type::Float|Type::Double)
+        || expr.presented.as_ref()!=Some(&Type::Reference(format!("{}[]",element.spell()))){return Ok(false)}
+    for value in values{if !primitive_array_value(value,budget)?{return Ok(false)}}Ok(true)
+}
+fn primitive_array_value(expr:&Expr,budget:&mut Budget)->Result<bool,crate::stop::StopReason>{
+    crate::stop::poll(budget,Some(expr.origin.primary().bci()))?;
+    crate::stop::charge(budget,jarde_reader::budget::CountedBudgetDimension::AnalysisSteps,1,Some(expr.origin.primary().bci()))?;
+    match &expr.kind {
+        ExprKind::Integer(_)|ExprKind::Boolean(_)|ExprKind::Long(_)|ExprKind::Float(_)|ExprKind::Double(_)=>Ok(true),
+        ExprKind::Cast{ty,value} if matches!(ty,Type::Boolean|Type::Byte|Type::Char|Type::Short|Type::Int|Type::Long|Type::Float|Type::Double)=>primitive_array_value(value,budget),
+        ExprKind::Call{receiver:None,args,..}=>{for arg in args{if !primitive_array_literal(arg,budget)?{return Ok(false)}}Ok(true)},
+        _=>Ok(false),
+    }
+}
+fn primitive_array_literal(expr:&Expr,budget:&mut Budget)->Result<bool,crate::stop::StopReason>{
+    crate::stop::poll(budget,Some(expr.origin.primary().bci()))?;
+    crate::stop::charge(budget,jarde_reader::budget::CountedBudgetDimension::AnalysisSteps,1,Some(expr.origin.primary().bci()))?;
+    match &expr.kind{ExprKind::Integer(_)|ExprKind::Boolean(_)|ExprKind::Long(_)|ExprKind::Float(_)|ExprKind::Double(_)=>Ok(true),ExprKind::Cast{ty,value} if matches!(ty,Type::Boolean|Type::Byte|Type::Char|Type::Short|Type::Int|Type::Long|Type::Float|Type::Double)=>primitive_array_literal(value,budget),_=>Ok(false)}
+}
