+        (ExprKind::Long(x),ExprKind::Long(y))=>x==y,(ExprKind::Float(x),ExprKind::Float(y))=>x==y,(ExprKind::Double(x),ExprKind::Double(y))=>x==y,
+        (ExprKind::Cast{ty:x,value: xv},ExprKind::Cast{ty:y,value:yv})=>x==y&&compare_array_value(xv,asrc,yv,bsrc,budget)?,
+        (ExprKind::Call{receiver:None,name:x,args:xa},ExprKind::Call{receiver:None,name:y,args:ya})=>{
