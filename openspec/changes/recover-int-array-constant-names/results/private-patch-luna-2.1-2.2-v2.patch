+    fn direct_array_names_reject_unsupported_shapes_shadowing_duplicates_and_staged_target() {
+        let unsupported = compiled(
+            "ArrayUnsupported",
+            "class ArrayUnsupported { static final int VALUE=7; static int[][] nested(){return new int[][]{{7}};} static int[] value(){return new int[]{make()};} static int make(){return 7;} }",
+        );
+        let report = source(&unsupported, "ArrayUnsupported", &mut task_budget(&[]).unwrap());
+        let value = report
+            .methods
+            .iter()
+            .find(|method| method.item.name.raw().0 == b"value")
+            .unwrap();
+        assert!(!value.text.contains("VALUE"));
+        assert!(report.integer_constant_projections.is_empty());
+
+        let shadowed = compiled(
+            "ArrayShadow",
+            "class ArrayShadow { static final int VALUE=7; static int[] value(int VALUE){return new int[]{7};} static int[] local(){int VALUE=8; return new int[]{7};} }",
+        );
+        let report = source(&shadowed, "ArrayShadow", &mut task_budget(&[]).unwrap());
+        let value = report
+            .methods
+            .iter()
+            .find(|method| method.item.name.raw().0 == b"value")
+            .unwrap();
+        assert!(value.text.contains("new int[]{7}"));
+        assert!(report.integer_constant_projections.is_empty());
+
+        let duplicate = compiled(
+            "ArrayDuplicate",
+            "class ArrayDuplicate { static final int VALUE=7; static final int OTHER=7; static int[] value(){return new int[]{7};} }",
+        );
+        let report = source(&duplicate, "ArrayDuplicate", &mut task_budget(&[]).unwrap());
+        let value = report
+            .methods
+            .iter()
+            .find(|method| method.item.name.raw().0 == b"value")
+            .unwrap();
+        assert!(value.text.contains("new int[]{7}"));
+        assert!(report.integer_constant_projections.is_empty());
+
+        let bytes = compiled(
+            "ArrayPriorProjection",
+            "class ArrayPriorProjection { static final int VALUE=7; static int[] value(){return new int[]{7};} }",
+        );
+        let report = source(&bytes, "ArrayPriorProjection", &mut task_budget(&[]).unwrap());
+        let method = report
+            .methods
+            .iter()
+            .find(|method| method.item.name.raw().0 == b"value")
+            .unwrap();
+        let prior = [class_source::ClassSourceProjectedMemberText {
+            member: method.item.index,
+            text: method.text.clone(),
+            emission: None,
+        }];
+        let prior_same_member = prior
+            .iter()
+            .any(|staged| staged.member == method.item.index);
+        assert!(!integer_array_projection_source_is_current(
+            method,
+            Some(""),
+            prior_same_member,
+        ));
+        assert!(!integer_array_projection_source_is_current(method, None, false));
+        assert!(!integer_array_projection_source_is_current(method, Some(""), false));
+    }
