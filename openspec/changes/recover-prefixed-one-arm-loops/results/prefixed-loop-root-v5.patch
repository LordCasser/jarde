+            entry_source,
+            exit_target,
+            edges,
+            self.budget,
+            Some(first.bci()),
+        )? {
+            return Ok(false);
+        }
+        charge(
+            self.budget,
+            CountedBudgetDimension::AnalysisSteps,
+            u64::try_from(blocks.len()).unwrap_or(u64::MAX),
+            Some(first.bci()),
+        )?;
+        for block in blocks {
+            poll(self.budget, Some(block.bci()))?;
+            if block.path() != branch.path()
+                || self
+                    .view
+                    .index_of(block)
+                    .is_none_or(|node| !self.visited.contains(&node) || frame.stops_at(node))
+            {
+                return Ok(false);
+            }
+        }
+        Ok(true)
+    }
