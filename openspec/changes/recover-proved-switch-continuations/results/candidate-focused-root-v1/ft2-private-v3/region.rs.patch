+        fn find_outer_if(region: &Region) -> Option<&Region> {
+            match region {
+                Region::If { branch_bci: 5, .. } => Some(region),
+                Region::Sequence { regions } => regions.iter().find_map(find_outer_if),
+                _ => None,
