+        fn find_switch(region: &Region) -> Option<&Region> {
+            match region {
+                Region::Switch { branch_bci: 11, .. } => Some(region),
+                Region::Sequence { regions } => regions.iter().find_map(find_switch),
+                Region::If { then_arm, else_arm, .. } => {
