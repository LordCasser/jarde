+                    && self
+                        .view
+                        .id_of(*candidate)
+                        .is_some_and(|id| id.path() == dispatch_id.path())
+                {
+                    direct_candidates.push((group.2, *candidate));
+                }
+            }
+        }
+        let mut join_candidates = Vec::new();
+        for (candidate_bci, candidate) in direct_candidates {
+            poll(self.budget, Some(at))?;
+            charge(
+                self.budget,
