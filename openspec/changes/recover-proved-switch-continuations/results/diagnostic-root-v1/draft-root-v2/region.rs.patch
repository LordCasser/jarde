+    #[test]
+    fn cf12_switch_continuation_temporary_diagnostic() {
+        use jarde_jvm::engine::analyze_method_ir;
+        use jarde_jvm::environment::ResolutionEnvironment;
+        use jarde_jvm::ir::{AnalysisStage, MethodAnalysisRequest};
+        use jarde_reader::artifact::{ArtifactInput, ArtifactSnapshot};
+        use jarde_reader::budget::{Budget, Limits};
+        use jarde_reader::model::{
+            ClassBytesId, Digest, JvmBytes, PhysicalClassLocation, PhysicalDefinitionId,
+            PhysicalMethodId, PhysicalVariant,
+        };
+        use jarde_reader::view::{
+            DelegationPolicy, LayoutMode, LoadDomain, LoadRoot, LoaderId, ModuleMode,
+            MultiReleasePolicy, PhysicalScope, PhysicalView, RuntimeProfile, RuntimeUncertainty,
+            RuntimeView,
+        };
+
+        fn diagnose(class: &[u8], method: &[u8], descriptor: &[u8], label: &str) {
+            let mut budget = Budget::new(Limits {
+                input_bytes: 1 << 20,
+                archive_entries: 100,
+                entry_bytes: 1 << 20,
+                read_bytes: 1 << 20,
+                class_bytes: 1 << 20,
+                attribute_bytes: 1 << 20,
+                code_bytes: 1 << 20,
+                result_items: 1 << 20,
+                output_bytes: 1 << 20,
+                class_headers: 100,
+                method_bodies: 100,
+                ir_items: 1 << 20,
+                ir_edges: 1 << 20,
+                analysis_steps: 1 << 20,
+                normalization_clones: 1 << 20,
+                nested_depth: 32,
+                dependency_depth: 32,
+                elapsed_millis: u64::MAX,
+            });
+            let snapshot = ArtifactSnapshot::open(ArtifactInput::bytes(class.to_vec()), &mut budget)
+                .expect("frozen switch class opens");
+            let definition = PhysicalDefinitionId {
+                location: PhysicalClassLocation::StandaloneRoot { snapshot: snapshot.id().clone() },
+                class_bytes: ClassBytesId {
+                    digest: Digest(blake3::hash(class).to_hex().to_string()),
+                    length: u64::try_from(class.len()).expect("fixture length fits"),
+                },
+                variant: PhysicalVariant::Base,
+            };
+            let domain = LoadDomain {
+                loader: LoaderId("app".to_owned()),
+                parent_loader: None,
+                delegation: DelegationPolicy::ParentFirst,
+                roots: vec![LoadRoot::StandaloneClass { snapshot: snapshot.id().clone() }],
+                module_mode: ModuleMode::ClassPath,
+                external_override: RuntimeUncertainty::None,
+                runtime_transformation: RuntimeUncertainty::None,
+            };
+            let analysis = analyze_method_ir(
+                &[snapshot.clone()],
+                &MethodAnalysisRequest {
+                    environment: ResolutionEnvironment {
+                        runtime: RuntimeView {
+                            physical: PhysicalView {
+                                snapshot: snapshot.id().clone(),
+                                scope: PhysicalScope::SnapshotAll,
+                            },
+                            profile: RuntimeProfile {
+                                java_release: 8,
+                                multi_release: MultiReleasePolicy::Disabled,
+                                layout: LayoutMode::Generic,
+                            },
+                            load_domain: domain.clone(),
+                        },
+                        domains: vec![domain],
+                        providers: Vec::new(),
+                    },
+                    method: PhysicalMethodId {
+                        owner: definition,
+                        name: JvmBytes(method.to_vec()),
+                        descriptor: JvmBytes(descriptor.to_vec()),
+                    },
+                    stages: AnalysisStage::ALL.to_vec(),
+                },
+                &mut budget,
+            ).expect("reader analyzes the exact real switch method");
+            let ir = analysis.ir();
+            let canonical = ir.canonical().expect("canonical CFG from exact method");
+            let ssa = ir.ssa().expect("SSA from exact method");
+            let code = ir.code().expect("decoded code from exact method");
+            let operations = Operations::of(code, ir.constant_pool());
+            let chains = crate::concat::plan_four_conditional_strings(
+                ssa,
+                canonical,
+                &operations,
+                &crate::build::FieldCopies::default(),
+                &mut budget,
+            ).expect("existing condition planner completes");
+            let view = NormalFlowView::build(canonical, &mut budget)
+                .expect("normal-flow view from same canonical CFG");
+            eprintln!("[switch-continuation-diagnostic] begin {label} blocks={} edges={}", canonical.blocks().len(), canonical.edges().len());
+            eprintln!("[switch-continuation-diagnostic] canonical {label} rows={:?}", canonical.edges().iter().map(|e| (e.from().bci(), e.kind(), e.to().bci())).collect::<Vec<_>>());
+            let result = recover(
+                canonical,
+                &view,
+                ssa,
+                &operations,
+                ir.constant_pool(),
+                &chains,
+                &crate::init::Sites::empty(),
+                code,
+                Some(false),
+                false,
+                &crate::pass::JAVA_8,
+                &mut budget,
+            ).expect("actual region recovery completes");
+            eprintln!("[switch-continuation-diagnostic] end {label} regions={:?}", diagnostic_run_outline(&result.regions));
+        }
+
+        const SWITCH2: &[u8] = include_bytes!("../../../openspec/evidence/java-syntax-2026-10-11/cf12-upstream-remaining-root-v1/direct-root-v1/capture/TestSwitch2.test/input/TestSwitch2$TestCls.class");
+        const FALLTHROUGH2: &[u8] = include_bytes!("../../../openspec/evidence/java-syntax-2026-10-11/cf12-upstream-remaining-root-v1/direct-root-v1/capture/TestSwitchWithFallThroughCase2.test/input/TestSwitchWithFallThroughCase2$TestCls.class");
+        diagnose(SWITCH2, b"test", b"(I)V", "TestSwitch2.test(I)V");
+        diagnose(FALLTHROUGH2, b"test", b"(IZZ)Ljava/lang/String;", "TestSwitchWithFallThroughCase2.test(IZZ)String");
+    }
