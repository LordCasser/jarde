+#[cfg(test)]
+fn diagnostic_run_outline(run: &[Region]) -> Vec<(&'static str, Vec<u32>, Option<&'static str>)> {
+    run.iter()
+        .map(|region| {
+            let (kind, refusal) = match region {
+                Region::Straight { .. } => ("straight", None),
+                Region::If { .. } => ("if", None),
+                Region::Switch { .. } => ("switch", None),
+                Region::Fallback { reason, .. } => ("fallback", Some(reason.code())),
+                Region::Loop { .. } => ("loop", None),
+                Region::Sequence { .. } => ("sequence", None),
+                _ => ("other", None),
+            };
+            (
+                kind,
+                region.blocks().iter().map(|block| block.bci()).collect(),
+                refusal,
+            )
+        })
+        .collect()
+}
