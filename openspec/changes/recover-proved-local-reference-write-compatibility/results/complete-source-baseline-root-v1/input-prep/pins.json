  "expected_case_oracles": [
    {
      "case": "literal-seeded-object",
      "expected_source_semantics": "Legacy Runner unchanged cases; baseline-v1 Jarde full-class had eight compile failures and no Jarde runtime. New capture must re-run; never reuse old outputs as new results."
    },
    {
      "case": "cast-read",
      "stdout_line": "cast-read|result=4|exception=none",
      "expected_candidate_boundary": "Object write followed by checkcast and String.length; not a unique direct Object Return, so the new candidate must refuse."
    },
    {
      "case": "char-sequence-string",
      "stdout_line": "char-sequence-string|result=6|exception=none",
      "expected_candidate_boundary": "String write with CharSequence.length; the candidate must not unconditionally widen this interface case to Object. Capture existing reliable source or precise fallback; original runtime line remains the oracle."
    },
    {
      "case": "char-sequence-builder",
      "stdout_line": "char-sequence-builder|result=7|exception=none",
      "expected_candidate_boundary": "String and StringBuilder writes with CharSequence.length; must not be unconditionally Objectified. Existing refusal/fallback is recorded distinctly from a successful generated compile/runtime."
    },
    {
      "case": "reference-array-string-array",
      "stdout_line": "reference-array-string-array|result=1|exception=none",
      "expected_candidate_boundary": "Branch reassigns String[] to CharSequence[] before indexed String store/read; scalar-local Object proof must not alter the array descriptor or runtime behavior."
    },
    {
      "case": "reference-array-interface-array",
      "stdout_line": "reference-array-interface-array|result=1|exception=none",
      "expected_candidate_boundary": "Branch reassigns String[] to CharSequence[] before indexed String store/read; scalar-local Object proof must not alter the array descriptor or runtime behavior."
    },
    {
      "case": "parameter-write",
      "stdout_line": "parameter-write|result=after|exception=none",
      "expected_candidate_boundary": "Keep descriptor (Object,List)Object; parameter identity is excluded from new candidate."
    },
