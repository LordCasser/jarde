+            charge(
+                self.budget,
+                CountedBudgetDimension::AnalysisSteps,
+                1,
+                Some(pop_bci),
+            )?;
+            origin = origin.plus_derived(Origin::derived(pop_bci));
+        }
+        Ok(origin)
+    }
