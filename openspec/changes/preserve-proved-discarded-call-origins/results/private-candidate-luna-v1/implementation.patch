+    fn call_statement_origin(&mut self, call_bci: u32) -> Result<OriginSet, StopReason> {
+        let mut origin = OriginSet::new(Origin::direct(call_bci));
+        if let Some(pop_bci) = self.pops().discarded_result_pop(call_bci) {
