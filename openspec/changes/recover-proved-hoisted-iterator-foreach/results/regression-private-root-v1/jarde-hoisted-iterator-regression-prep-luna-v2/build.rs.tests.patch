+                .inputs()
+                .iter()
+                .filter(|input| **input == PhiInput::Value(iterator))
+                .count(),
+            1
+        );
+        let matching = ssa
+            .phis()
+            .iter()
+            .find(|phi| {
+                phi.block().bci() == 97
+                    && phi
+                        .inputs()
+                        .iter()
+                        .any(|input| *input == PhiInput::Value(iterator))
+            })
