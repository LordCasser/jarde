+    fn iterator_test_debug_locals(
+        code: &jarde_reader::classfile::MethodCodeFacts,
+    ) -> Vec<DebugLocal> {
+        let jarde_reader::classfile::LocalDebugTable::Read(records) = code.debug() else {
+            return Vec::new();
+        };
+        records
+            .iter()
+            .map(|record| {
+                DebugLocal::over(
+                    record.slot,
+                    record.name_lossy(),
+                    record.start_bci,
+                    record.end_bci,
+                )
+            })
+            .collect()
+    }
