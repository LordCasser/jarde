+        assert_eq!(
+            matching
+                .inputs()
+                .iter()
+                .filter(|input| **input == PhiInput::Value(iterator))
+                .count(),
+            3,
+            "the three operands are counted as occurrences, not a set"
+        );
+        let unrelated = ssa
+            .phis()
+            .iter()
+            .find(|phi| {
+                phi.block().bci() == 97
+                    && phi.slot() == Slot::Local(6)
+                    && phi
