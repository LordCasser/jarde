+    /// Prove a small, acyclic comparison closure with exactly the ordinary-if join and one
+    /// statement exit. The caller has already entered `root`, so no mutation is made here.
+    fn compound_statement_condition(
+        &mut self,
+        root: &CanonicalBlockId,
+        root_bci: u32,
+        root_op: CompareOp,
+        root_target: u32,
+        frame: &Frame,
+        join_node: usize,
+    ) -> Result<Option<CompoundProof>, StopReason> {
+        let Some(root_node) = self.view.index_of(root) else {
+            return Ok(None);
+        };
+        let Some(join) = self.view.id_of(join_node).cloned() else {
+            return Ok(None);
+        };
+        if join == *root
+            || root.path() != join.path()
+            || frame.boundary == Some(root_node)
+            || frame.scope.as_ref().is_some_and(|scope| !scope.contains(&root_node))
+            || frame.case_entries.as_ref().is_some_and(|entries| entries.contains(&root_node))
+            || self.view.is_loop_header(root_node)
+            || frame
+                .scope
+                .as_ref()
+                .is_some_and(|scope| frame.boundary != Some(join_node) && !scope.contains(&join_node))
+            || frame.case_entries.as_ref().is_some_and(|entries| entries.contains(&join_node))
+            || frame.loop_exit == Some(join_node)
+            || frame.switch_join == Some(join_node)
+            || frame.loop_targets.iter().any(|target| {
+                target.break_target == Some(join_node) || target.continue_target == join_node
+            })
+        {
+            return Ok(None);
+        }
+
+        poll(self.budget, Some(root_bci))?;
+        let root_successors = self.view.successor_ids(root);
+        charge(
+            self.budget,
+            CountedBudgetDimension::AnalysisSteps,
+            u64::try_from(root_successors.len()).unwrap_or(u64::MAX),
+            Some(root_bci),
+        )?;
+        if self.split_arms(&root_successors, root_target).is_none() {
+            return Ok(None);
+        }
+        let root_instruction_count = self
+            .ssa
+            .block(root)
+            .map_or(0, |names| names.instructions().len());
+        charge(
+            self.budget,
+            CountedBudgetDimension::AnalysisSteps,
+            u64::try_from(root_instruction_count).unwrap_or(u64::MAX),
+            Some(root_bci),
+        )?;
+        if self.branch_arity_proved(root, root_bci, root_op).is_err() {
+            return Ok(None);
+        }
+        let mut discovered = BTreeMap::<usize, CompoundTest>::new();
+        let mut color = BTreeMap::<usize, u8>::new();
+        let mut stack = vec![(root_node, false)];
+        let mut exits = BTreeSet::<CanonicalBlockId>::new();
+        while let Some((node, leaving)) = stack.pop() {
+            let Some(block) = self.view.id_of(node).cloned() else {
+                return Ok(None);
+            };
+            if leaving {
+                color.insert(node, 2);
+                continue;
+            }
+            match color.get(&node).copied().unwrap_or(0) {
+                1 => return Ok(None),
+                2 => continue,
+                _ => {}
+            }
+            poll(self.budget, Some(block.bci()))?;
+            charge(
+                self.budget,
+                CountedBudgetDimension::AnalysisSteps,
+                1,
+                Some(block.bci()),
+            )?;
+            if block.path() != root.path()
+                || frame.boundary == Some(node)
+                || frame.scope.as_ref().is_some_and(|scope| !scope.contains(&node))
+                || frame.case_entries.as_ref().is_some_and(|entries| entries.contains(&node))
+                || self.view.is_loop_header(node)
+                || self.excluded_edge_nodes.contains(&block)
+                || (node != root_node && self.visited.contains(&node))
+            {
+                return Ok(None);
+            }
+            let (branch_bci, op, target) = if node == root_node {
+                (root_bci, root_op, root_target)
+            } else {
+                let Some(branch_bci) = self.terminal_bci(&block) else {
+                    exits.insert(block);
+                    continue;
+                };
+                let Some((op, target)) = self
+                    .operations
+                    .get(branch_bci)
+                    .and_then(Operation::comparison)
+                else {
+                    exits.insert(block);
+                    continue;
+                };
+                let instruction_count = self
+                    .ssa
+                    .block(&block)
+                    .map_or(0, |names| names.instructions().len());
+                charge(
+                    self.budget,
+                    CountedBudgetDimension::AnalysisSteps,
+                    u64::try_from(instruction_count).unwrap_or(u64::MAX),
+                    Some(block.bci()),
+                )?;
+                if self.branch_arity_proved(&block, branch_bci, op).is_err()
+                    || self.test_is_pure(&block, branch_bci, false).is_err()
+                {
+                    exits.insert(block);
+                    continue;
+                }
+                (branch_bci, op, target)
+            };
+            let successors = self.view.successor_ids(&block);
+            charge(
+                self.budget,
+                CountedBudgetDimension::AnalysisSteps,
+                u64::try_from(successors.len()).unwrap_or(u64::MAX),
+                Some(block.bci()),
+            )?;
+            let Some((then, otherwise)) = self.split_arms(&successors, target) else {
+                return Ok(None);
+            };
+            if successors.len() != 2 || then == otherwise {
+                return Ok(None);
+            }
+            if discovered.len() >= 24 {
+                return Ok(None);
+            }
+            discovered.insert(
+                node,
+                CompoundTest {
+                    block: block.clone(),
+                    branch_bci,
+                    then: then.clone(),
+                    otherwise: otherwise.clone(),
+                },
+            );
+            color.insert(node, 1);
+            stack.push((node, true));
+            for successor in [otherwise, then].into_iter().rev() {
+                let child = self.view.index_of(&successor);
+                if child == Some(root_node)
+                    || child.is_some_and(|child| {
+                        child != join_node && self.visited.contains(&child)
+                    })
+                {
+                    return Ok(None);
+                }
+                let is_test = child.is_some_and(|child| {
+                    child != join_node
+                        && !frame.boundary.is_some_and(|boundary| boundary == child)
+                        && !frame.scope.as_ref().is_some_and(|scope| !scope.contains(&child))
+                        && !frame.case_entries.as_ref().is_some_and(|entries| entries.contains(&child))
+                        && successor.path() == root.path()
+                        && !self.excluded_edge_nodes.contains(&successor)
+                        && !self.visited.contains(&child)
+                        && !self.view.is_loop_header(child)
+                        && self.terminal_bci(&successor).is_some_and(|bci| {
+                            self.operations.get(bci).and_then(Operation::comparison).is_some()
+                        })
+                });
+                if is_test {
+                    stack.push((child.expect("test node has a canonical index"), false));
+                } else {
+                    exits.insert(successor);
+                }
+            }
+        }
+        if discovered.len() < 2 || exits.len() != 2 || !exits.contains(&join) {
+            return Ok(None);
+        }
+        let Some(payload) = exits.iter().find(|exit| **exit != join).cloned() else {
+            return Ok(None);
+        };
+        let Some(payload_node) = self.view.index_of(&payload) else {
+            return Ok(None);
+        };
+        if payload.path() != root.path()
+            || frame.boundary == Some(payload_node)
+            || frame.scope.as_ref().is_some_and(|scope| !scope.contains(&payload_node))
+            || frame.case_entries.as_ref().is_some_and(|entries| entries.contains(&payload_node))
+            || self.visited.contains(&payload_node)
+        {
+            return Ok(None);
+        }
+
+        // Check every physical edge touching the test closure in one charged pass. This catches
+        // duplicate rows, exceptional/context edges, and canonical predecessors that the normal
+        // projection alone would hide.
+        let scan_cost = u64::try_from(self.canonical.edges().len()).unwrap_or(u64::MAX);
+        charge(
+            self.budget,
+            CountedBudgetDimension::AnalysisSteps,
+            scan_cost,
+            Some(root_bci),
+        )?;
+        let test_ids: BTreeSet<CanonicalBlockId> =
+            discovered.values().map(|test| test.block.clone()).collect();
+        let mut outgoing = BTreeMap::<CanonicalBlockId, Vec<CanonicalBlockId>>::new();
+        let mut incoming = BTreeMap::<CanonicalBlockId, Vec<CanonicalBlockId>>::new();
+        for edge in self.canonical.edges() {
+            poll(self.budget, Some(edge.from().bci()))?;
+            let from_test = test_ids.contains(edge.from());
+            let to_test = test_ids.contains(edge.to());
+            if from_test || to_test {
+                if edge.kind() != CanonicalEdgeKind::Normal {
+                    return Ok(None);
+                }
+                if from_test {
+                    outgoing
+                        .entry(edge.from().clone())
+                        .or_default()
+                        .push(edge.to().clone());
+                }
+                if to_test {
+                    incoming
+                        .entry(edge.to().clone())
+                        .or_default()
+                        .push(edge.from().clone());
+                }
+            }
+        }
+        charge(
+            self.budget,
+            CountedBudgetDimension::AnalysisSteps,
+            u64::try_from(discovered.len()).unwrap_or(u64::MAX),
+            Some(root_bci),
+        )?;
+        for test in discovered.values() {
+            let Some(rows) = outgoing.get(&test.block) else {
+                return Ok(None);
+            };
+            let expected = [test.then.clone(), test.otherwise.clone()];
+            if rows.len() != 2
+                || rows[0] == rows[1]
+                || !expected.iter().all(|target| rows.contains(target))
+            {
+                return Ok(None);
+            }
+            if test.block != *root {
+                let Some(sources) = incoming.get(&test.block) else {
+                    return Ok(None);
+                };
+                charge(
+                    self.budget,
+                    CountedBudgetDimension::AnalysisSteps,
+                    u64::try_from(sources.len())
+                        .unwrap_or(u64::MAX)
+                        .saturating_mul(2),
+                    Some(test.branch_bci),
+                )?;
+                let Some(test_node) = self.view.index_of(&test.block) else {
+                    return Ok(None);
+                };
+                let projected_sources = self.view.predecessors(test_node);
+                charge(
+                    self.budget,
+                    CountedBudgetDimension::AnalysisSteps,
+                    u64::try_from(projected_sources.len()).unwrap_or(u64::MAX),
+                    Some(test.branch_bci),
+                )?;
+                let projected: BTreeSet<CanonicalBlockId> = projected_sources
+                    .into_iter()
+                    .filter_map(|source| self.view.id_of(source).cloned())
+                    .collect();
+                let actual: BTreeSet<CanonicalBlockId> = sources.iter().cloned().collect();
+                if sources.len() != actual.len()
+                    || actual != projected
+                    || actual.is_empty()
+                    || actual.iter().any(|source| !test_ids.contains(source))
+                {
+                    return Ok(None);
+                }
+            } else {
+                let Some(sources) = incoming.get(&test.block) else {
+                    if self
+                        .canonical
+                        .blocks()
+                        .first()
+                        .is_some_and(|entry| entry.id() == root)
+                    {
+                        continue;
+                    }
+                    return Ok(None);
+                };
+                if sources.len() != 1 || sources[0] == *root {
+                    return Ok(None);
+                }
+                let source = &sources[0];
+                let source_was_walked = self
+                    .view
+                    .index_of(source)
