+/// Whether the actual SSA operand of a local write is directly stated as Java `char`.
+///
+/// This is deliberately one producer step: descriptors on an invocation/field, the explicit
+/// `i2c` opcode, or a load whose local read is the method-entry value of a char parameter. A
+/// frame's shared `Int` category and a consumer's required argument type are not evidence.
+fn local_value_has_char_source(
+    value: ValueId,
+    ssa: &SsaTable,
+    operations: &Operations,
+    parameter_types: &BTreeMap<u16, Type>,
+    parameters: u16,
+    budget: &mut Budget,
+) -> Result<bool, StopReason> {
+    let Definition::Instruction {
+        block: definition_block,
+        bci,
+    } = ssa.value(value).def()
+    else {
+        return Ok(false);
+    };
+    let is_char = match operations.get(*bci) {
+        Some(Operation::PrimitiveConversion {
+            target: Type::Char,
+            ..
+        }) => true,
+        Some(Operation::Invoke(target)) => return_type(target.descriptor()) == Some(Type::Char),
+        Some(Operation::Field {
+            access: FieldAccess::Read,
+            descriptor,
+            ..
+        }) => descriptor == "C",
+        Some(Operation::Load { slot }) if *slot < parameters => {
+            if parameter_types.get(slot) != Some(&Type::Char) {
+                false
+            } else {
+                let Some(block) = ssa.block(definition_block) else {
+                    return Ok(false);
+                };
+                let mut is_entry_load = false;
+                for instruction in block.instructions() {
+                    charge(
+                        budget,
+                        CountedBudgetDimension::AnalysisSteps,
+                        1,
+                        Some(instruction.bci()),
+                    )?;
+                    poll(budget, Some(instruction.bci()))?;
+                    if instruction.bci() != *bci {
+                        continue;
+                    }
+                    for (read_slot, read_value) in instruction.reads() {
+                        charge(
+                            budget,
+                            CountedBudgetDimension::AnalysisSteps,
+                            1,
+                            Some(instruction.bci()),
+                        )?;
+                        poll(budget, Some(instruction.bci()))?;
+                        if read_slot == &Slot::Local(*slot)
+                            && matches!(
+                                ssa.value(*read_value).def(),
+                                Definition::Entry {
+                                    slot: Slot::Local(entry_slot),
+                                    ..
+                                } if entry_slot == slot
+                            )
+                        {
+                            is_entry_load = true;
+                            break;
+                        }
+                    }
+                    break;
+                }
+                is_entry_load
+            }
+        }
+        _ => false,
+    };
+    Ok(is_char)
+}
