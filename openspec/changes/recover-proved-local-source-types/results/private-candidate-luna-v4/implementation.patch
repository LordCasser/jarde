+/// A literal can initialize or assign a `char` only through Java's constant-assignment range.
+fn local_value_is_char_literal(
+    value: ValueId,
+    ssa: &SsaTable,
+    operations: &Operations,
+) -> bool {
+    let Definition::Instruction { bci, .. } = ssa.value(value).def() else {
+        return false;
+    };
+    matches!(
+        operations.get(*bci),
+        Some(Operation::Push(ConstantValue::Int(value))) if (0..=u16::MAX as i64).contains(value)
+    )
 }
 
+/// One non-null local write's exact type, only when its stored SSA value comes directly from a
+/// producer that states a reference type. This boundary deliberately does not follow Load/Store,
+/// Duplicate, Phi, or an arbitrary unknown-reference chain.
+fn direct_reference_write_type(
+    value: ValueId,
+    ssa: &SsaTable,
+    operations: &Operations,
+) -> Option<Type> {
+    let Definition::Instruction { bci, .. } = ssa.value(value).def() else {
+        return None;
+    };
+    match operations.get(*bci)? {
+        Operation::Push(ConstantValue::String(_)) => {
+            Some(Type::Reference("java.lang.String".to_owned()))
+        }
+        Operation::Push(ConstantValue::Class { .. }) => {
+            Some(Type::Reference("java.lang.Class".to_owned()))
+        }
+        Operation::Invoke(target) => {
+            let result = return_type(target.descriptor());
+            match result {
+                Some(ty @ Type::Reference(_)) => Some(ty),
+                None
+                    if target.kind() == InvokeKind::Special
+                        && target.name() == "<init>"
+                        && target.descriptor().ends_with(")V")
+                        && matches!(
+                            ssa.value(value).ty(),
+                            Value::Ref(RefType::Named { name, .. })
+                                if name.as_slice() == target.owner().as_bytes()
+                        ) =>
+                {
+                    // Frame verification permits exactly this call to convert an uninitialized
+                    // allocation token. SSA records the converted aliases as definitions at this
+                    // BCI, typed with the allocated class; requiring that name to equal the
+                    // constructor owner excludes an unrelated/incorrectly named receiver.
+                    Some(Type::Reference(target.owner().replace('/', ".")))
+                }
+                _ => None,
+            }
+        }
+        Operation::Field {
+            access: FieldAccess::Read,
+            descriptor,
+            ..
+        } => descriptor_type(descriptor).filter(|ty| matches!(ty, Type::Reference(_))),
+        Operation::Allocate { ty } => spell_reference(ty).map(Type::Reference),
+        Operation::NewArray {
+            element,
+            total_dimensions,
+            ..
+        } => array_spelling(element, u32::from(*total_dimensions)),
+        _ => None,
+    }
+}
