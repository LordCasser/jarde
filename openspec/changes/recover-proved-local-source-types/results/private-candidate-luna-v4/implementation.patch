+/// The only fallback that refines an actual null first write: every non-null stored operand must
+/// independently state the same exact reference type, and at least one such write must exist.
+fn null_leading_reference_type(
+    first: &FirstWrite,
+    uses: &[SlotUse],
+    ssa: &SsaTable,
+    operations: &Operations,
+    budget: &mut Budget,
+) -> Result<Option<Type>, StopReason> {
+    if !matches!(ssa.value(first.stored).ty(), Value::Null) {
+        return Ok(None);
+    }
+    charge(
+        budget,
+        CountedBudgetDimension::AnalysisSteps,
+        u64::try_from(uses.len()).unwrap_or(u64::MAX),
+        Some(first.at),
+    )?;
+    let mut common = None;
+    let mut has_non_null = false;
+    for use_ in uses {
+        poll(budget, Some(use_.bci))?;
+        if use_.path.is_none() {
+            return Ok(None);
+        }
+        let Some(written) = use_.written else {
+            continue;
+        };
+        let stored = use_.stored.unwrap_or(written);
+        if matches!(ssa.value(stored).ty(), Value::Null) {
+            continue;
+        }
+        let Some(ty @ Type::Reference(_)) = direct_reference_write_type(stored, ssa, operations)
+        else {
+            return Ok(None);
+        };
+        has_non_null = true;
+        if common.as_ref().is_some_and(|previous| previous != &ty) {
+            return Ok(None);
+        }
+        common = Some(ty);
+    }
+    Ok(has_non_null.then_some(common).flatten())
+}
