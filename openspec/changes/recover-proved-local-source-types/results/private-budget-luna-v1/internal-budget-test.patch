+// Test-only gate tracing lets a budget bound be derived from this real method's own preceding work.
+// It records no SSA facts and does not change non-test builds.
+#[cfg(test)]
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum LocalTypeBudgetGate {
+    CharWrite,
+    NullReferenceWrites,
+}
+
+#[cfg(test)]
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+struct LocalTypeBudgetTarget {
+    gate: LocalTypeBudgetGate,
+    slot: u16,
+    index: u16,
+    bci: u32,
+}
+
+#[cfg(test)]
+#[derive(Clone, Debug, Eq, PartialEq)]
+struct LocalTypeBudgetMark {
+    gate: LocalTypeBudgetGate,
+    slot: u16,
+    index: u16,
+    bci: u32,
+    start_steps: u64,
+    amount: u64,
+    writes: usize,
+}
+
+#[cfg(test)]
+struct LocalTypeBudgetTrace {
+    marks: Vec<LocalTypeBudgetMark>,
+    cancel_at: Option<LocalTypeBudgetTarget>,
+    did_cancel: bool,
+}
+
+#[cfg(test)]
+std::thread_local! {
+    static LOCAL_TYPE_BUDGET_TRACE: std::cell::RefCell<Option<LocalTypeBudgetTrace>> =
+        std::cell::RefCell::new(None);
+}
+
+#[cfg(test)]
+fn start_local_type_budget_trace(cancel_at: Option<LocalTypeBudgetTarget>) {
+    LOCAL_TYPE_BUDGET_TRACE.with(|trace| {
+        *trace.borrow_mut() = Some(LocalTypeBudgetTrace {
+            marks: Vec::new(),
+            cancel_at,
+            did_cancel: false,
+        });
+    });
+}
+
+#[cfg(test)]
+fn observe_local_type_budget_gate(
+    gate: LocalTypeBudgetGate,
+    variable: LocalVariable,
+    bci: u32,
+    amount: u64,
+    writes: usize,
+    budget: &Budget,
+) {
+    LOCAL_TYPE_BUDGET_TRACE.with(|trace| {
+        let mut trace = trace.borrow_mut();
+        let Some(trace) = trace.as_mut() else {
+            return;
+        };
+        let mark = LocalTypeBudgetMark {
+            gate,
+            slot: variable.slot(),
+            index: variable.index(),
+            bci,
+            start_steps: budget.counted_usage(CountedBudgetDimension::AnalysisSteps),
+            amount,
+            writes,
+        };
+        if !trace.did_cancel
+            && trace.cancel_at
+                == Some(LocalTypeBudgetTarget {
+                    gate,
+                    slot: mark.slot,
+                    index: mark.index,
+                    bci,
+                })
+        {
+            trace.did_cancel = true;
+            budget.cancellation_token().cancel();
+        }
+        trace.marks.push(mark);
+    });
 }
 
+#[cfg(test)]
+fn take_local_type_budget_trace() -> Vec<LocalTypeBudgetMark> {
+    LOCAL_TYPE_BUDGET_TRACE.with(|trace| {
+        trace
+            .borrow_mut()
+            .take()
+            .map_or_else(Vec::new, |trace| trace.marks)
+    })
+}
