+        eprintln!("CF11_SEQLOOPS2_DIAG class_len={} class_blake3={} method=test{}", CLASS.len(), blake3::hash(CLASS).to_hex(), descriptor);
+        eprintln!("CF11_SEQLOOPS2_CANONICAL blocks={} edges={} unreachable={:?}", canonical.blocks().len(), canonical.edges().len(), canonical.unreachable());
+        for edge in canonical.edges() {
+            eprintln!("CF11_SEQLOOPS2_EDGE kind={:?} from={:?} to={:?}", edge.kind(), edge.from(), edge.to());
+        }
+        for (node, id) in view.ids().iter().enumerate() {
+            let pred = view.predecessors(node).iter().filter_map(|n| view.id_of(*n).map(|b| b.bci())).collect::<Vec<_>>();
+            let succ = view.successors(node).iter().filter_map(|n| view.id_of(*n).map(|b| b.bci())).collect::<Vec<_>>();
+            eprintln!("CF11_SEQLOOPS2_NORMAL node={} id={:?} preds={:?} succs={:?}", node, id, pred, succ);
+        }
