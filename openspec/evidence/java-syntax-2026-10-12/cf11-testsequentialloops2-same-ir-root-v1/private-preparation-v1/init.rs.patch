+                eprintln!("CF11_SEQLOOPS2_INSN block={:?} bci={} opcode={} reads={:?} writes={:?} operation={:?}", block.block(), instruction.bci(), instruction.opcode(), instruction.reads(), instruction.writes(), operations.get(instruction.bci()));
+            }
+        }
+        let mut values = BTreeSet::new();
+        for block in ssa.blocks() {
+            for instruction in block.instructions().iter().filter(|instruction| (83..=99).contains(&instruction.bci())) {
+                values.extend(instruction.reads().iter().map(|(_, value)| *value));
+                values.extend(instruction.writes().iter().map(|(_, value)| *value));
+            }
+        }
