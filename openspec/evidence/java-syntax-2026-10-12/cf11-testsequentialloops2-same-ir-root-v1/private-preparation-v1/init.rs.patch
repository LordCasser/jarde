+        fn find_branch(region: &crate::region::Region, target: u32) -> Option<&crate::region::Region> {
+            use crate::region::Region;
+            match region {
+                Region::Sequence { regions } | Region::Loop { body: regions, .. } =>
+                    regions.iter().find_map(|child| find_branch(child, target)),
+                Region::If { branch_bci, then_arm, else_arm, .. } => {
+                    if *branch_bci == target { Some(region) }
+                    else { find_branch(then_arm, target).or_else(|| find_branch(else_arm, target)) }
+                }
+                _ => None,
+            }
+        }
