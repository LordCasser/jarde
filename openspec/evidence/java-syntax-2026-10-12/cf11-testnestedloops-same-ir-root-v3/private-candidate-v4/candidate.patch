+    #[test]
+    #[ignore = "temporary diagnostic; requires the frozen class and explicit logger opt-in"]
+    fn frozen_upstream_nested_loops_foreach_candidate_diagnostic() {
+        assert!(
+            std::env::var_os("JARDE_FOREACH_CANDIDATE_DIAGNOSTIC").is_some(),
+            "set the explicit diagnostic opt-in for this one frozen-class run"
+        );
+        const FROZEN_CLASS: &[u8] = include_bytes!(
+            "/private/tmp/jarde-cf11-testnestedloops-baseline-root-v1/legs/javac23-original/classes/cf11/UpstreamNestedLoops.class"
+        );
+        let engine = Engine::new();
+        let mut budget = Budget::new(task_limits(&[]).expect("task limits are valid"));
+        let snapshot = engine
+            .open(ArtifactInput::bytes(FROZEN_CLASS.to_vec()), &mut budget)
+            .expect("the frozen target class opens");
+        let request = ClassSourceRequest {
+            class: ClassRef::Name {
+                class: ClassNameQuery::dotted("cf11.UpstreamNestedLoops"),
+            },
+            environment: EnvironmentRequest {
+                snapshot: snapshot.id().clone(),
+                scope: PhysicalScope::SnapshotAll,
+                policy: EnvironmentPolicy::SingleClass,
+                profile: RuntimeProfile {
+                    java_release: 8,
+                    multi_release: crate::MultiReleasePolicy::Disabled,
+                    layout: LayoutMode::Generic,
+                },
+                loader: LoaderId("app".to_owned()),
+            },
+        };
+        match engine
+            .class_source(std::slice::from_ref(&snapshot), &request, &mut budget)
+            .expect("class-source recovery runs on the frozen class")
+        {
+            OperationOutcome::Performed(_) => {}
+            other => panic!("the frozen class produces one class-source report: {other:?}"),
+        }
+    }
+
