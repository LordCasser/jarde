+// Temporary explicit opt-in for one frozen TestNestedLoops same-IR diagnostic run.
+fn foreach_candidate_diagnostic_enabled() -> bool {
+    std::env::var_os("JARDE_FOREACH_CANDIDATE_DIAGNOSTIC").is_some()
+}
+
+fn foreach_candidate_loop_body(kind: &StmtKind) -> Option<&[Stmt]> {
+    match kind {
+        StmtKind::While { body, .. }
+        | StmtKind::DoWhile { body, .. }
+        | StmtKind::For { body, .. }
+        | StmtKind::ForEach { body, .. } => Some(body.as_slice()),
+        _ => None,
+    }
+}
+
+fn foreach_candidate_statement_kind(statement: Option<&Stmt>) -> &'static str {
+    let Some(statement) = statement else {
+        return "none";
+    };
+    match &statement.kind {
+        StmtKind::Declare { .. } => "Declare",
+        StmtKind::Assign { .. } => "Assign",
+        StmtKind::Expr(_) => "Expr",
+        StmtKind::FieldAssign { .. } => "FieldAssign",
+        StmtKind::IndexAssign { .. } => "IndexAssign",
+        StmtKind::ConstructorCall { .. } => "ConstructorCall",
+        StmtKind::Return { .. } => "Return",
+        StmtKind::Break { .. } => "Break",
+        StmtKind::Continue { .. } => "Continue",
+        StmtKind::Throw { .. } => "Throw",
+        StmtKind::Assert { .. } => "Assert",
+        StmtKind::If { .. } => "If",
+        StmtKind::While { .. } => "While",
+        StmtKind::For { .. } => "For",
+        StmtKind::ForEach { .. } => "ForEach",
+        StmtKind::DoWhile { .. } => "DoWhile",
+        StmtKind::Switch { .. } => "Switch",
+        StmtKind::Try { .. } => "Try",
+        StmtKind::Synchronized { .. } => "Synchronized",
+        StmtKind::Fallback { .. } => "Fallback",
+    }
+}
+
+fn log_foreach_candidate(event: &str, test_bci: u32, detail: &str) {
+    if foreach_candidate_diagnostic_enabled() {
+        eprintln!("JARDE_FOREACH_CANDIDATE event={event} test_bci={test_bci} {detail}");
+    }
+}
 
