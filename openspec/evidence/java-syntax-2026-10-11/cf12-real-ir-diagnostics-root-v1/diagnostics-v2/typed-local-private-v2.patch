+#[cfg(test)]
+fn capture_local_source_type_diagnostics(
+    uses: &BTreeMap<LocalVariable, Vec<SlotUse>>,
+    first: &BTreeMap<LocalVariable, FirstWrite>,
+    decided: &BTreeMap<LocalVariable, Decided>,
+    ssa: &SsaTable,
+    operations: &Operations,
+    reuse: &reuse::Plan,
+) {
+    LOCAL_SOURCE_TYPE_DIAGNOSTICS.with(|capture| {
+        let mut capture = capture.borrow_mut();
+        let Some(lines) = capture.as_mut() else {
+            return;
+        };
+        for (variable, accesses) in uses {
+            let Some(decision) = decided.get(variable) else {
+                continue;
+            };
+            let writes: Vec<_> = accesses.iter().filter(|access| access.written.is_some()).collect();
+            let first_write = first.get(variable);
+            let reuse_at_first = first_write
+                .and_then(|write| reuse.variable_at(variable.slot(), write.at));
+            let (first_frame, first_def, first_operation) = first_write.map_or(
+                (None, None, None),
+                |write| {
+                    let value = ssa.value(write.stored);
+                    let bci = match value.def() {
+                        Definition::Instruction { bci, .. } => Some(*bci),
+                        _ => None,
+                    };
+                    (
+                        Some(value.ty()),
+                        Some(value.def()),
+                        bci.and_then(|bci| operations.get(bci)),
+                    )
+                },
+            );
+            lines.push(format!(
+                "LOCAL slot={} index={} var={variable:?} reuse_at_first={reuse_at_first:?} writes={} old_decided={decision:?} first_at={:?} first_stored={:?} first_frame={first_frame:?} first_def={first_def:?} first_operation={first_operation:?}",
+                variable.slot(),
+                variable.index(),
+                writes.len(),
+                first_write.map(|write| write.at),
+                first_write.map(|write| write.stored),
+            ));
+            for access in writes {
+                let written = access.written.expect("filtered to writes");
+                let stored = access.stored.unwrap_or(written);
+                let written_value = ssa.value(written);
+                let stored_value = ssa.value(stored);
+                let producer_bci = match stored_value.def() {
+                    Definition::Instruction { bci, .. } => Some(*bci),
+                    _ => None,
+                };
+                let producer = producer_bci.and_then(|bci| operations.get(bci));
+                lines.push(format!(
+                    "WRITE slot={} index={} bci={} path={:?} reuse_at={:?} written={written:?} written_frame={:?} written_def={:?} stored={stored:?} stored_frame={:?} stored_def={:?} producer_bci={producer_bci:?} producer={producer:?}",
+                    variable.slot(),
+                    variable.index(),
+                    access.bci,
+                    access.path,
+                    reuse.variable_at(variable.slot(), access.bci),
+                    written_value.ty(),
+                    written_value.def(),
+                    stored_value.ty(),
+                    stored_value.def(),
+                ));
+            }
+        }
+    });
 }
 
