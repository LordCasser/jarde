+            input_bytes: 1 << 20,
+            archive_entries: 100,
+            entry_bytes: 1 << 20,
+            read_bytes: 1 << 20,
+            class_bytes: 1 << 20,
+            attribute_bytes: 1 << 20,
+            code_bytes: 1 << 20,
+            result_items: 1 << 20,
+            output_bytes: 1 << 20,
+            class_headers: 100,
+            method_bodies: 100,
+            ir_items: 1 << 20,
+            ir_edges: 1 << 20,
+            analysis_steps: 1 << 20,
+            normalization_clones: 1 << 20,
+            nested_depth: 32,
+            dependency_depth: 32,
+            elapsed_millis: u64::MAX,
+        });
+        let snapshot = ArtifactSnapshot::open(ArtifactInput::bytes(CLASS.to_vec()), &mut budget)
+            .expect("frozen adapted TestNestedLoops4 class opens");
+        let definition = PhysicalDefinitionId {
+            location: PhysicalClassLocation::StandaloneRoot {
+                snapshot: snapshot.id().clone(),
+            },
+            class_bytes: ClassBytesId {
+                digest: Digest(blake3::hash(CLASS).to_hex().to_string()),
+                length: u64::try_from(CLASS.len()).expect("class bytes fit u64"),
+            },
+            variant: PhysicalVariant::Base,
+        };
+        let domain = LoadDomain {
+            loader: LoaderId("app".to_owned()),
+            parent_loader: None,
+            delegation: DelegationPolicy::ParentFirst,
+            roots: vec![LoadRoot::StandaloneClass {
+                snapshot: snapshot.id().clone(),
+            }],
+            module_mode: ModuleMode::ClassPath,
+            external_override: RuntimeUncertainty::None,
+            runtime_transformation: RuntimeUncertainty::None,
+        };
+        let analysis = analyze_method_ir(
+            &[snapshot.clone()],
+            &MethodAnalysisRequest {
+                environment: ResolutionEnvironment {
+                    runtime: RuntimeView {
+                        physical: PhysicalView {
+                            snapshot: snapshot.id().clone(),
+                            scope: PhysicalScope::SnapshotAll,
+                        },
+                        profile: RuntimeProfile {
+                            java_release: 8,
+                            multi_release: MultiReleasePolicy::Disabled,
+                            layout: LayoutMode::Generic,
+                        },
+                        load_domain: domain.clone(),
+                    },
+                    domains: vec![domain],
+                    providers: Vec::new(),
+                },
+                method: PhysicalMethodId {
+                    owner: definition,
+                    name: JvmBytes(b"testFor".to_vec()),
+                    descriptor: JvmBytes(b"()I".to_vec()),
+                },
+                stages: AnalysisStage::ALL.to_vec(),
+            },
+            &mut budget,
+        )
+        .expect("Reader analyzes the exact real testFor class method");
+        let ir = analysis.ir();
+        let canonical = ir.canonical().expect("same IR has canonical CFG");
+        let ssa = ir.ssa().expect("same IR has SSA");
+        let code = ir.code().expect("same IR has decoded code");
+        let pool = ir.constant_pool();
+        let operations = Operations::of(code, pool);
+        let view = NormalFlowView::build(canonical, &mut budget)
+            .expect("same canonical CFG projects to normal flow");
+
+        eprintln!("CF11_CLASS bytes={} blake3={} physical_method=testFor()I", CLASS.len(), blake3::hash(CLASS).to_hex());
+        eprintln!("CF11_CANONICAL blocks={} edges={} unreachable={:?}", canonical.blocks().len(), canonical.edges().len(), canonical.unreachable());
+        for edge in canonical.edges() {
+            eprintln!("CF11_EDGE {:?} {:?} -> {:?}", edge.kind(), edge.from(), edge.to());
+        }
+        for (node, id) in view.ids().iter().enumerate() {
+            let bci_vec = |nodes: Vec<usize>| nodes.into_iter().filter_map(|n| view.id_of(n).map(CanonicalBlockId::bci)).collect::<Vec<_>>();
+            let loop_fact = view.loop_entered_at(node).map(|loop_of| (
+                loop_of.blocks().iter().filter_map(|n| view.id_of(*n).map(CanonicalBlockId::bci)).collect::<Vec<_>>(),
+                loop_of.latches().iter().filter_map(|n| view.id_of(*n).map(CanonicalBlockId::bci)).collect::<Vec<_>>(),
+                loop_of.is_irreducible(),
+            ));
+            let dominators = view.ids().iter().enumerate().filter_map(|(d, candidate)| view.dominates(d, node).then_some(candidate.bci())).collect::<Vec<_>>();
+            let ipdom = view.immediate_post_dominator(node).and_then(|next| view.id_of(next).map(CanonicalBlockId::bci));
+            eprintln!("CF11_NODE index={} id={:?} preds={:?} succs={:?} dominators={:?} ipdom={:?} natural_loop={:?}",
