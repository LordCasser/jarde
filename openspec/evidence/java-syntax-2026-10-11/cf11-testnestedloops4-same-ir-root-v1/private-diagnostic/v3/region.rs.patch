+        eprintln!("CF11_SSA_TABLE {:#?}", ssa);
+        for block in ssa.blocks() {
+            for instruction in block.instructions() {
+                eprintln!("CF11_INSN block={:?} bci={} opcode={} reads={:?} writes={:?} operation={:?}",
+                    block.block(), instruction.bci(), instruction.opcode(), instruction.reads(), instruction.writes(), operations.get(instruction.bci()));
